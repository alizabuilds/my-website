---
import {
  formatStageIndex,
  workProcessIntro,
  type WorkStage,
} from "../../data/work-process";

interface Props {
  stages: WorkStage[];
}

const { stages } = Astro.props;
---

<div class="stage">
  <div class="stage__inner">
    <p id="work-process-heading" class="kicker">
      How I work
    </p>
    <div class="panels">
      <article
        class="panel is-active"
        data-panel={workProcessIntro.id}
        data-resting
      >
        <p class="panel__index">00</p>
        <h2 class="panel__title">{workProcessIntro.title}</h2>
        <p class="panel__description">{workProcessIntro.description}</p>
      </article>
      {stages.map((stage, index) => (
        <article class="panel" data-panel={stage.id} aria-hidden="true" inert>
          <p class="panel__index">{formatStageIndex(index)}</p>
          <h2 class="panel__title">{stage.title}</h2>
          <p class="panel__description">{stage.description}</p>
        </article>
      ))}
    </div>
  </div>
</div>

<style>
  .stage {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    min-height: 0;
  }

  .stage__inner {
    width: min(100%, 36rem);
  }

  .kicker {
    margin: 0 0 1.35rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .panels {
    display: grid;
  }

  .panel {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition:
      opacity 380ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 380ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .panel.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .panel__index {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
  }

  .panel__title {
    margin: 0.45rem 0 0;
    min-height: 1.9em;
    font-family: var(--serif);
    font-size: clamp(2.6rem, 4.6vw, 4.6rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .panel__description {
    margin: 1rem 0 0;
    max-width: 34ch;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--muted);
  }

  @media (min-width: 861px) {
    .stage {
      padding-left: clamp(1.75rem, 3vw, 3.5rem);
      border-left: 1px solid var(--hairline);
    }
  }

  @media (max-width: 860px) {
    .stage {
      justify-content: flex-start;
      padding-top: 0.35rem;
    }

    .kicker {
      margin-bottom: 0.8rem;
    }

    .panel__title {
      font-size: clamp(2rem, 9vw, 2.8rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel {
      transition-duration: 0.01ms;
    }
  }
</style>
