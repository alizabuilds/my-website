---
import "../../styles/fonts.css";
import { workStages } from "../../data/work-process";
import ProductionLine from "./ProductionLine.astro";
import StageContent from "./StageContent.astro";
---

<section
  class="work-process"
  data-work-process
  aria-labelledby="work-process-heading"
>
  <div class="pin" data-pin>
    <div class="layout">
      <ProductionLine stages={workStages} />
      <StageContent stages={workStages} />
    </div>
  </div>
</section>

<script>
  import { mountWorkProcess } from "../../scripts/work-process";

  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-work-process]",
  )) {
    mountWorkProcess(root);
  }
</script>

<style>
  .work-process {
    --ink: #161b20;
    --paper: #fbfaf8;
    --muted: #8d9299;
    --hairline: rgb(22 27 32 / 0.2);
    --rail: rgb(22 27 32 / 0.34);
    --belt-fill: rgb(22 27 32 / 0.025);
    --slat: rgb(22 27 32 / 0.12);
    --product-fill: #fbfaf8;
    --lift: 3px 3px 0 rgb(22 27 32 / 0.16);
    --belt: 112px;
    --product-size: 88px;
    --serif: "Source Serif 4", Palatino, "Palatino Linotype", Georgia, serif;
    --sans:
      "IBM Plex Sans", "Avenir Next", "Segoe UI", "Helvetica Neue", sans-serif;
    --mono:
      "IBM Plex Mono", ui-monospace, "Cascadia Mono", "SFMono-Regular",
      monospace;

    position: relative;
    height: 420vh;
    overflow-anchor: none;
    isolation: isolate;
    background:
      radial-gradient(
        ellipse at 50% 31%,
        rgb(255 255 255 / 0.9),
        transparent 45%
      ),
      radial-gradient(
        ellipse at 53% 72%,
        rgb(246 243 239 / 0.75),
        transparent 48%
      ),
      var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-optical-sizing: auto;
    font-synthesis: none;
  }

  .work-process::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.045'/%3E%3C/svg%3E");
    content: "";
    opacity: 0.55;
    pointer-events: none;
  }

  .pin {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: stretch;
    height: 100%;
    min-height: 0;
    box-sizing: border-box;
    column-gap: clamp(1.5rem, 4vw, 4rem);
    padding: clamp(1.25rem, 3.5vh, 2.75rem) clamp(1.25rem, 4vw, 4rem);
  }

  @media (max-width: 860px) {
    .work-process {
      --belt: 74px;
      --product-size: 58px;
    }

    .layout {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(0, 1.2fr) minmax(0, 0.85fr);
      row-gap: 0.35rem;
      padding: 0.9rem 1.1rem 1.15rem;
    }
  }
</style>
