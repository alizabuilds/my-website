---
import { formatStageIndex, type WorkStage } from "../../data/work-process";

interface Props {
  stages: WorkStage[];
}

const { stages } = Astro.props;
---

<div class="line" data-line aria-hidden="true">
  <div class="field">
    <div class="track" data-track>
      <div class="belt" data-belt></div>
      {stages.map((stage, index) => (
        <div class="station" data-station={stage.id}>
          <div class="platen platen--label">
            <span class="station__index">{formatStageIndex(index)}</span>
            <p class="station__name">{stage.title}</p>
          </div>
          <div class="platen platen--tool">
            <span class="tool"></span>
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="product" data-product>
    <svg viewBox="0 0 88 88" fill="none">
      <rect
        x="0.5"
        y="0.5"
        width="87"
        height="87"
        fill="var(--product-fill)"
        stroke="currentColor"
      ></rect>
      <g class="threads" stroke="currentColor" stroke-linecap="round">
        <path
          class="product__thread"
          d="M16 28c8-12 16 8 28-4 8-8 14 6 30-2"
          stroke-width="1.25"
        ></path>
        <path
          class="product__thread"
          d="M14 40c12 12 16-18 30-2 10 12 12-14 30 4"
          stroke-width="1.2"
          opacity="0.85"
        ></path>
        <path
          class="product__thread"
          d="M18 56c10-8 16 14 30 0 8-8 14 6 24 4"
          stroke-width="1.25"
        ></path>
        <path
          class="product__thread"
          d="M20 68c12 6 14-12 28-2 8 6 10-2 22 2"
          stroke-width="1.1"
          opacity="0.7"
        ></path>
        <path
          class="product__thread"
          d="M30 18c-4 16 12 14 6 32-4 12 6 14 12 24"
          stroke-width="1.15"
        ></path>
        <path
          class="product__thread"
          d="M54 16c6 14-10 18 0 30 8 10-4 16 8 26"
          stroke-width="1.1"
          opacity="0.8"
        ></path>
      </g>
    </svg>
  </div>
</div>

<style>
  .line {
    position: relative;
    width: min(100%, 34rem);
    height: 100%;
    min-height: 0;
    margin-inline: auto;
    overflow: hidden;
  }

  .field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 7%,
      #000 93%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 7%,
      #000 93%,
      transparent 100%
    );
  }

  .track {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    will-change: transform;
  }

  .belt {
    position: absolute;
    top: -50%;
    bottom: -50%;
    left: 50%;
    width: var(--belt);
    transform: translate3d(-50%, var(--belt-shift, 0px), 0);
    border-right: 1px solid var(--rail);
    border-left: 1px solid var(--rail);
    background-color: var(--belt-fill);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0 20px,
      var(--slat) 20px 21px
    );
    will-change: transform;
  }

  .station {
    position: absolute;
    right: 0;
    left: 0;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: calc(var(--belt) + 1.75rem);
    align-items: stretch;
  }

  .platen {
    position: relative;
    box-sizing: border-box;
    min-height: 7.75rem;
    border: 1px solid var(--hairline);
    background: transparent;
    color: var(--ink);
    transition:
      background-color 240ms ease,
      color 240ms ease,
      border-color 240ms ease;
  }

  .station.is-active .platen {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  .platen--label {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    padding: 1rem 1.05rem 1rem 1.7rem;
    text-align: right;
  }

  .platen--label::before {
    content: "";
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    width: 0.38rem;
    height: 0.38rem;
    border: 1px solid currentColor;
  }

  .station.is-active .platen--label::before {
    background: currentColor;
  }

  .platen--tool {
    display: grid;
    place-items: center;
  }

  .station__index {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    opacity: 0.62;
  }

  .station__name {
    margin: 0.28rem 0 0;
    font-family: var(--serif);
    font-size: 1.2rem;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .tool {
    width: 2.6rem;
    height: 1px;
    background: currentColor;
    opacity: 0.55;
    box-shadow:
      0 8px 0 currentColor,
      0 16px 0 currentColor;
  }

  .product {
    position: absolute;
    z-index: 3;
    top: 0;
    left: 50%;
    width: var(--product-size);
    height: var(--product-size);
    color: var(--ink);
    transform: translate3d(-50%, 12%, 0);
    will-change: transform;
    filter: drop-shadow(3px 3px 0 rgb(26 23 20 / 0.1));
  }

  .product svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .threads {
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .threads {
      animation: drift 9s ease-in-out infinite alternate;
    }

    .product__thread:nth-child(odd) {
      animation: wander 7.5s ease-in-out infinite alternate;
    }
  }

  @media (max-width: 860px) {
    .belt {
      right: 0;
      left: auto;
      transform: translate3d(0, var(--belt-shift, 0px), 0);
    }

    .station {
      right: auto;
      width: calc(100% - var(--belt) - 0.85rem);
      grid-template-columns: 1fr;
    }

    .platen--tool {
      display: none;
    }

    .platen {
      min-height: 4.6rem;
    }

    .station__name {
      font-size: 1rem;
    }
  }

  @keyframes drift {
    from {
      transform: rotate(-0.8deg);
    }
    to {
      transform: rotate(1deg) translateY(0.6px);
    }
  }

  @keyframes wander {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(0.7px, -1.1px);
    }
  }
</style>
