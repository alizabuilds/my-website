<style>
  .line {
    position: relative;
    width: min(100%, 34rem);
    height: 100%;
    min-height: 0;
    margin-inline: auto;
    overflow: hidden;
  }

  .field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 7%,
      #000 93%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 7%,
      #000 93%,
      transparent 100%
    );
  }

  .track {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    will-change: transform;
  }

  .belt {
    position: absolute;
    top: -50%;
    bottom: -50%;
    left: 50%;
    width: var(--belt);
    transform: translate3d(-50%, var(--belt-shift, 0px), 0);
    border-right: 1px solid var(--rail);
    border-left: 1px solid var(--rail);
    background-color: var(--belt-fill);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0 19px,
      var(--slat) 19px 20px
    );
    will-change: transform;
  }

  .station {
    position: absolute;
    left: 50%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
    width: min(15.5rem, calc(100% - 1.25rem));
    padding: 0.9rem 1.05rem 0.75rem;
    border: 1px solid var(--hairline);
    background: var(--product-fill);
    color: var(--ink);
    text-align: center;
    box-shadow: var(--lift);
    transform: translateX(-50%);
    transition:
      background-color 240ms ease,
      color 240ms ease,
      border-color 240ms ease,
      box-shadow 240ms ease;
  }

  .station.is-active {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
    box-shadow: none;
  }

  .station__copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: 0.15rem 0.4rem 0;
  }

  .station__copy::before {
    content: "";
    position: absolute;
    top: 0.05rem;
    left: 0.05rem;
    width: 0.38rem;
    height: 0.38rem;
    border: 1px solid currentColor;
  }

  .station.is-active .station__copy::before {
    background: currentColor;
  }

  .station__seat {
    display: grid;
    place-items: center;
    width: 100%;
    height: var(--product-size);
    margin-top: 0.45rem;
  }

  .station__index {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    opacity: 0.62;
  }

  .station__name {
    margin: 0.28rem 0 0;
    font-family: var(--serif);
    font-size: 1.2rem;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .tool {
    width: 2.75rem;
    height: auto;
  }

  .product {
    position: absolute;
    z-index: 1;
    top: 0;
    left: 50%;
    width: var(--product-size);
    height: var(--product-size);
    display: grid;
    color: var(--ink);
    transform: translate3d(-50%, 12%, 0);
    will-change: transform;
    box-shadow: var(--lift);
  }

  .product__plate,
  .product__state {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    height: 100%;
  }

  .product__state {
    opacity: 0;
    transition: opacity 380ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .product[data-state="vague"] .product__state--vague,
  .product[data-state="defined"] .product__state--defined,
  .product[data-state="built"] .product__state--built,
  .product[data-state="refined"] .product__state--refined,
  .product[data-state="fit"] .product__state--fit {
    opacity: 1;
  }

  .vague-lines {
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .product[data-state="vague"] .vague-lines {
      animation: drift 9s ease-in-out infinite alternate;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product__state {
      transition-duration: 0.01ms;
    }
  }

  @media (max-width: 860px) {
    .station {
      width: min(13.5rem, calc(100% - 0.75rem));
      padding: 0.7rem 0.8rem 0.55rem;
    }

    .station__name {
      font-size: 1.05rem;
    }

    .tool {
      width: 2.15rem;
    }
  }

  @keyframes drift {
    from {
      transform: rotate(-0.6deg);
    }
    to {
      transform: rotate(0.7deg) translateY(0.4px);
    }
  }
</style>
