---
import {
  formatStageIndex,
  workProcessIntro,
  type WorkStage,
} from "../../data/work-process";

interface Props {
  stages: WorkStage[];
}

const { stages } = Astro.props;
---

<div class="line" data-line aria-hidden="true">
  <div class="field">
    <div class="track" data-track>
      <div class="belt" data-belt></div>
      {stages.map((stage, index) => (
        <div
          class="station"
          data-station={stage.id}
          data-product-state={stage.productState}
        >
          <div class="station__copy">
            <span class="station__index">{formatStageIndex(index)}</span>
            <p class="station__name">{stage.title}</p>
          </div>
          <div class="station__seat">
            <svg class="tool" viewBox="0 0 36 22" fill="none">
              <path
                d="M5 7.5H31M18 7.5V16.5"
                stroke="currentColor"
                stroke-width="1.35"
                stroke-linecap="round"
              ></path>
            </svg>
          </div>
        </div>
      ))}
      <div
        class="product"
        data-product
        data-state={workProcessIntro.productState}
        data-resting-state={workProcessIntro.productState}
      >
        <svg class="product__plate" viewBox="0 0 88 88" fill="none">
          <rect
            x="0.5"
            y="0.5"
            width="87"
            height="87"
            fill="var(--product-fill)"
            stroke="currentColor"
          ></rect>
        </svg>
