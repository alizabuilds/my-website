---
import { formatStageIndex, type WorkStage } from "../../data/work-process";

interface Props {
  stages: WorkStage[];
}

const { stages } = Astro.props;
---

<div class="line" data-line aria-hidden="true">
  <div class="field">
    <div class="track" data-track>
      <div class="belt" data-belt></div>
      {stages.map((stage, index) => (
        <div class="station" data-station={stage.id}>
          <div class="station__copy">
            <span class="station__index">{formatStageIndex(index)}</span>
            <p class="station__name">{stage.title}</p>
          </div>
          <div class="station__seat">
            <svg class="tool" viewBox="0 0 36 22" fill="none">
              <path
                d="M5 7.5H31M18 7.5V16.5"
                stroke="currentColor"
                stroke-width="1.35"
                stroke-linecap="round"
              ></path>
            </svg>
          </div>
        </div>
      ))}
      <div class="product" data-product data-state="threads">
        <svg class="product__plate" viewBox="0 0 88 88" fill="none">
          <rect
            x="0.5"
            y="0.5"
            width="87"
            height="87"
            fill="var(--product-fill)"
            stroke="currentColor"
          ></rect>
        </svg>
        <svg
          class="product__state product__state--threads"
          viewBox="0 0 88 88"
          fill="none"
        >
          <g class="threads" stroke="currentColor" stroke-linecap="round">
            <path d="M26 24C46 20 58 36 48 48" stroke-width="1.4"></path>
            <path d="M62 26C66 46 48 58 40 46" stroke-width="1.4"></path>
            <path d="M64 62C44 70 30 54 40 42" stroke-width="1.4"></path>
            <path d="M24 60C20 42 36 30 48 40" stroke-width="1.4"></path>
          </g>
        </svg>
        <svg
          class="product__state product__state--plan"
          viewBox="0 0 88 88"
          fill="none"
        >
          <path
            d="M32 24V66M32 30H66M32 44H50M32 58H60"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
          ></path>
        </svg>
        <svg
          class="product__state product__state--soft"
          viewBox="0 0 88 88"
          fill="none"
        >
          <path
            d="M18 30V20H70V30M18 66V42H50V66"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linejoin="miter"
          ></path>
        </svg>
        <svg
          class="product__state product__state--concrete"
          viewBox="0 0 88 88"
          fill="none"
        >
          <rect x="18" y="20" width="52" height="10" fill="currentColor"></rect>
          <rect x="18" y="42" width="32" height="24" fill="currentColor"></rect>
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  .line {
    position: relative;
    width: min(100%, 34rem);
    height: 100%;
    min-height: 0;
    margin-inline: auto;
    overflow: hidden;
  }

  .field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 7%,
      #000 93%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 7%,
      #000 93%,
      transparent 100%
    );
  }

  .track {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    will-change: transform;
  }

  .belt {
    position: absolute;
    top: -50%;
    bottom: -50%;
    left: 50%;
    width: var(--belt);
    transform: translate3d(-50%, var(--belt-shift, 0px), 0);
    border-right: 1px solid var(--rail);
    border-left: 1px solid var(--rail);
    background-color: var(--belt-fill);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0 20px,
      var(--slat) 20px 21px
    );
    will-change: transform;
  }

  .station {
    position: absolute;
    left: 50%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
    width: min(15.5rem, calc(100% - 1.25rem));
    padding: 0.9rem 1.05rem 0.75rem;
    border: 1px solid var(--hairline);
    background: var(--product-fill);
    color: var(--ink);
    text-align: center;
    box-shadow: var(--lift);
    transform: translateX(-50%);
    transition:
      background-color 240ms ease,
      color 240ms ease,
      border-color 240ms ease,
      box-shadow 240ms ease;
  }

  .station.is-active {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
    box-shadow: none;
  }

  .station__copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: 0.15rem 0.4rem 0;
  }

  .station__copy::before {
    content: "";
    position: absolute;
    top: 0.05rem;
    left: 0.05rem;
    width: 0.38rem;
    height: 0.38rem;
    border: 1px solid currentColor;
  }

  .station.is-active .station__copy::before {
    background: currentColor;
  }

  .station__seat {
    display: grid;
    place-items: center;
    width: 100%;
    height: var(--product-size);
    margin-top: 0.45rem;
  }

  .station__index {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    opacity: 0.62;
  }

  .station__name {
    margin: 0.28rem 0 0;
    font-family: var(--serif);
    font-size: 1.2rem;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .tool {
    width: 2.75rem;
    height: auto;
  }

  .product {
    position: absolute;
    z-index: 1;
    top: 0;
    left: 50%;
    width: var(--product-size);
    height: var(--product-size);
    display: grid;
    color: var(--ink);
    transform: translate3d(-50%, 12%, 0);
    will-change: transform;
    box-shadow: var(--lift);
  }

  .product__plate,
  .product__state {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    height: 100%;
  }

  .product__state {
    opacity: 0;
    transition: opacity 380ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .product[data-state="threads"] .product__state--threads,
  .product[data-state="plan"] .product__state--plan,
  .product[data-state="soft"] .product__state--soft,
  .product[data-state="concrete"] .product__state--concrete {
    opacity: 1;
  }

  .threads {
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .product[data-state="threads"] .threads {
      animation: drift 9s ease-in-out infinite alternate;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product__state {
      transition-duration: 0.01ms;
    }
  }

  @media (max-width: 860px) {
    .station {
      width: min(13.5rem, calc(100% - 0.75rem));
      padding: 0.7rem 0.8rem 0.55rem;
    }

    .station__name {
      font-size: 1.05rem;
    }

    .tool {
      width: 2.15rem;
    }
  }

  @keyframes drift {
    from {
      transform: rotate(-0.6deg);
    }
    to {
      transform: rotate(0.7deg) translateY(0.4px);
    }
  }
</style>
