---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p>© {year} Aliza Latifi</p>
</footer>

<button class="back-to-top" type="button" data-back-to-top aria-label="Back to top">
  ↑
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-back-to-top]");

  if (button) {
    const updateVisibility = () => {
      const documentHeight = document.documentElement.scrollHeight;
      const reachedEnd =
        window.scrollY + window.innerHeight >= documentHeight - 120;

      button.classList.toggle("is-visible", reachedEnd);
    };

    button.addEventListener("click", () => {
      window.history.replaceState(
        null,
        "",
        `${window.location.pathname}${window.location.search}`,
      );
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    window.addEventListener("scroll", updateVisibility, { passive: true });
    window.addEventListener("resize", updateVisibility);
    updateVisibility();
  }
</script>

<style>
  .site-footer {
    --muted: #8d9299;
    --paper: #fbfaf8;
    --mono: "IBM Plex Mono", ui-monospace, monospace;

    padding: 0.25rem clamp(1rem, 2.5vw, 2rem) clamp(1.5rem, 3vw, 2.25rem);
    background: var(--paper);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-align: center;
  }

  p {
    max-width: 1000px;
    margin: 0 auto;
  }

  .back-to-top {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 10;
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: #106962;
    color: #fff;
    cursor: pointer;
    font-size: 1.5rem;
    font-weight: 300;
    line-height: 1;
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.75rem);
    transition:
      background-color 180ms ease,
      opacity 180ms ease,
      transform 180ms ease;
  }

  .back-to-top.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  .back-to-top:hover,
  .back-to-top:focus-visible {
    background: #0f6f69;
    transform: translateY(-2px);
  }

  .back-to-top:focus-visible {
    outline: 2px solid #106962;
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition-duration: 0.01ms;
    }
  }
</style>
